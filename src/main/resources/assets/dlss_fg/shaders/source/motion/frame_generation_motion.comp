#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D currentDepth;
layout(set = 0, binding = 1) uniform sampler2D currentColor;
layout(set = 0, binding = 2) uniform sampler2D previousDepth;
layout(set = 0, binding = 3) uniform sampler2D previousColor;
layout(rg16f, set = 0, binding = 4) uniform writeonly image2D motionOutput;
// 1 where reprojecting the previous frame cannot explain the pixel (particles,
// fire, animated water, disocclusion): tells DLSS/FSR to trust the current frame.
layout(r8, set = 0, binding = 6) uniform writeonly image2D reactiveOutput;

layout(std140, set = 0, binding = 5) uniform FrameParameters {
    mat4 clipToPreviousClip;
    vec2 renderSize;
    vec2 jitterDeltaPixels;
    uint resetHistory;
    uint searchRadius;
    // Layout: ObjectMotion.java. Positions are relative to the current camera.
    mat4 clipToCameraRelative;
    mat4 cameraRelativeToPreviousClip;
    uvec4 entityInfo; // x = entity count
    // Per entity: min (w = first part), max (w = part count), translation since last frame.
    vec4 entityBoxes[192];
} frame;

// Cubes of the rigid model parts of the entities above (EntityPartMotion.java):
// rows of two affine transforms (current camera-relative -> part space, part
// space -> previous position relative to the current camera) and the cube's
// bounds in part space.
struct PartMotion {
    vec4 toLocal[3];
    vec4 toPrevious[3];
    vec4 boundsMin;
    vec4 boundsMax;
};
layout(std430, set = 0, binding = 7) readonly buffer EntityParts {
    PartMotion parts[];
} entityParts;

const uint MAX_PARTS = 2048u;
// ObjectMotion.BOX_MARGIN: how far the boxes reach past the hitbox.
const float BOX_MARGIN = 0.2;

vec3 applyRows(vec4 rows[3], vec3 point) {
    vec4 p = vec4(point, 1.0);
    return vec3(dot(rows[0], p), dot(rows[1], p), dot(rows[2], p));
}

// Previous position of the surface point (relative to the current camera),
// from the model cube it lies on, else from the translation of a moving
// entity box around it. False when no entity explains the point.
bool entityPreviousPosition(vec3 relative, out vec3 previousRelative) {
    uint count = min(frame.entityInfo.x, 64u);
    // Depth precision drops with distance; a surface point sits on a cube face
    // give or take this much (blocks, roughly part space).
    float tolerance = 0.03 + 0.004 * length(relative);
    float bestSurface = tolerance;
    bool onPart = false;
    int translated = -1;
    for (uint i = 0u; i < count; ++i) {
        vec4 minimum = frame.entityBoxes[i * 3u];
        vec4 maximum = frame.entityBoxes[i * 3u + 1u];
        if (any(lessThan(relative, minimum.xyz)) || any(greaterThan(relative, maximum.xyz))) {
            continue;
        }
        uint first = min(floatBitsToUint(minimum.w), MAX_PARTS);
        uint end = min(first + floatBitsToUint(maximum.w), MAX_PARTS);
        for (uint part = first; part < end; ++part) {
            vec3 local = applyRows(entityParts.parts[part].toLocal, relative);
            vec3 below = local - entityParts.parts[part].boundsMin.xyz;
            vec3 above = entityParts.parts[part].boundsMax.xyz - local;
            // A visible point lies on a face of its own cube: pick the cube
            // whose surface is nearest (inside = positive, slightly outside =
            // negative), so a limb wins over the body it sinks into.
            float inside = min(min(min(below.x, below.y), below.z), min(min(above.x, above.y), above.z));
            float surface = abs(inside);
            if (inside >= -tolerance && surface < bestSurface) {
                bestSurface = surface;
                previousRelative = applyRows(entityParts.parts[part].toPrevious, local);
                onPart = true;
            }
        }
        vec3 delta = frame.entityBoxes[i * 3u + 2u].xyz;
        // With a model, the margin below the feet is ground, not entity.
        bool aboveGround = end == first || relative.y > minimum.y + BOX_MARGIN;
        if (translated < 0 && aboveGround && dot(delta, delta) > 0.0) {
            translated = int(i);
        }
    }
    if (onPart) {
        return true;
    }
    if (translated >= 0) {
        // Held items, name tags and models without parts: box translation.
        previousRelative = relative - frame.entityBoxes[uint(translated) * 3u + 2u].xyz;
        return true;
    }
    return false;
}

float colorError(vec3 a, vec3 b) {
    vec3 difference = abs(a - b);
    return dot(difference, vec3(0.299, 0.587, 0.114));
}

float candidateScore(
    vec3 currentRgb,
    ivec2 candidate,
    float expectedDepth,
    vec2 offset
) {
    vec3 previousRgb = texelFetch(previousColor, candidate, 0).rgb;
    float previousZ = texelFetch(previousDepth, candidate, 0).r;
    return colorError(currentRgb, previousRgb)
        + abs(previousZ - expectedDepth) * 2.0
        + length(offset) * 0.0035;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    // The storage image is authoritative. Using the uniform render size here
    // made the whole dispatch silently return when a malformed/stale uniform
    // upload decoded the dimensions as zero.
    ivec2 size = imageSize(motionOutput);
    vec2 renderSize = vec2(size);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    if (frame.resetHistory != 0u) {
        imageStore(motionOutput, pixel, vec4(0.0));
        imageStore(reactiveOutput, pixel, vec4(0.0));
        return;
    }

    vec2 currentUv = (vec2(pixel) + vec2(0.5)) / renderSize;
    float depth = texelFetch(currentDepth, pixel, 0).r;
    // Poisoned depth (NaN/Inf from a torn history image) must never reach
    // DLSS-FG, and sky/near-plane edge pixels (reversed depth: far = 0.0,
    // near = 1.0) carry no meaningful reprojection — emit a static vector.
    if (isnan(depth) || isinf(depth) || depth <= 0.0 || depth >= 1.0) {
        imageStore(motionOutput, pixel, vec4(0.0));
        imageStore(reactiveOutput, pixel, vec4(0.0));
        return;
    }
    // Texture/GUI Y grows downwards, while the JOML camera projection used by
    // the renderer has clip-space Y growing upwards. Convert both directions
    // explicitly; treating Y like X mirrors vertical and diagonal motion.
    vec2 currentNdc = vec2(
        currentUv.x * 2.0 - 1.0,
        1.0 - currentUv.y * 2.0
    );
    vec4 previousClip = frame.clipToPreviousClip * vec4(currentNdc, depth, 1.0);

    // A non-finite w (NaN projection after a torn uniform upload) would
    // spray infinite vectors across providers — fail closed to static.
    if (abs(previousClip.w) < 1.0e-6 || isnan(previousClip.w) || isinf(previousClip.w)) {
        imageStore(motionOutput, pixel, vec4(0.0));
        imageStore(reactiveOutput, pixel, vec4(0.0));
        return;
    }

    // Entities: move the surface point to where its model part (or, without
    // parts, the whole entity) was last frame before reprojecting. Exact, so
    // no colour search needed.
    bool exactObjectMotion = false;
    if (frame.entityInfo.x > 0u) {
        vec4 relativeClip = frame.clipToCameraRelative * vec4(currentNdc, depth, 1.0);
        if (abs(relativeClip.w) > 1.0e-6) {
            vec3 relative = relativeClip.xyz / relativeClip.w;
            vec3 previousRelative;
            if (entityPreviousPosition(relative, previousRelative)) {
                vec4 objectClip = frame.cameraRelativeToPreviousClip * vec4(previousRelative, 1.0);
                if (abs(objectClip.w) > 1.0e-6 && !any(isnan(objectClip)) && !any(isinf(objectClip))) {
                    previousClip = objectClip;
                    exactObjectMotion = true;
                }
            }
        }
    }

    vec2 predictedPreviousNdc = previousClip.xy / previousClip.w;
    vec2 predictedPreviousUv = vec2(
        predictedPreviousNdc.x * 0.5 + 0.5,
        0.5 - predictedPreviousNdc.y * 0.5
    );
    vec2 predictedPreviousPixel = predictedPreviousUv * renderSize - vec2(0.5);
    vec3 currentRgb = texelFetch(currentColor, pixel, 0).rgb;

    ivec2 predictedPixel = clamp(
        ivec2(round(predictedPreviousPixel)),
        ivec2(0),
        size - 1
    );
    ivec2 bestPixel = predictedPixel;
    int radius = int(clamp(frame.searchRadius, 0u, 8u));
    float expectedDepth = previousClip.z / previousClip.w;
    float seedScore = candidateScore(
        currentRgb,
        predictedPixel,
        expectedDepth,
        vec2(0.0)
    );
    float bestScore = seedScore;
    int coarseStep = max(1, radius / 2);

    // Camera reprojection supplies the initial vector. Most static pixels
    // already match and avoid all optical-flow work. A mismatching pixel gets
    // a coarse pass plus 3x3 refinement (at most 34 candidates for radius 4,
    // instead of the previous 81 candidates at every render pixel).
    // radius 0: camera reprojection only (previous frame has another size).
    if (radius > 0 && !exactObjectMotion && seedScore > 0.04) {
        for (int y = -radius; y <= radius; y += coarseStep) {
            for (int x = -radius; x <= radius; x += coarseStep) {
                ivec2 candidate = clamp(
                    predictedPixel + ivec2(x, y),
                    ivec2(0),
                    size - 1
                );
                float score = candidateScore(
                    currentRgb,
                    candidate,
                    expectedDepth,
                    vec2(x, y)
                );
                if (score < bestScore) {
                    bestScore = score;
                    bestPixel = candidate;
                }
            }
        }
        ivec2 coarseBest = bestPixel;
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec2 candidate = clamp(
                    coarseBest + ivec2(x, y),
                    ivec2(0),
                    size - 1
                );
                vec2 offset = vec2(candidate - predictedPixel);
                float score = candidateScore(
                    currentRgb,
                    candidate,
                    expectedDepth,
                    offset
                );
                if (score < bestScore) {
                    bestScore = score;
                    bestPixel = candidate;
                }
            }
        }
        if (seedScore - bestScore < 0.01) {
            bestPixel = predictedPixel;
        }
    }

    // SDK convention: current pixel plus motion vector locates the same
    // surface in the previous frame. Jitter is removed in pixel space.
    vec2 motionPixels = vec2(bestPixel - pixel) - frame.jitterDeltaPixels;
    imageStore(motionOutput, pixel, vec4(motionPixels, 0.0, 0.0));
    // Exact entity motion needs no bias; elsewhere a large residual after the
    // best match means the history is wrong for this pixel.
    float reactive = exactObjectMotion ? 0.0 : smoothstep(0.08, 0.25, bestScore);
    imageStore(reactiveOutput, pixel, vec4(reactive));
}
