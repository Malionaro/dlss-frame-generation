#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, set = 0, binding = 0) uniform readonly image2D hdrInput;
layout(rgba8, set = 0, binding = 1) uniform writeonly image2D sdrOutput;

vec3 linearToSrgb(vec3 value) {
    vec3 low = value * 12.92;
    vec3 high = 1.055 * pow(max(value, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
    return mix(high, low, lessThanEqual(value, vec3(0.0031308)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(sdrOutput);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    vec3 hdr = max(imageLoad(hdrInput, pixel).rgb, vec3(0.0));
    // ACES fitted tone map keeps sun-lit blocks and reflections inside the
    // SDR main target while preserving the HDR signal supplied to DLSS-RR.
    vec3 mapped = clamp(
        (hdr * (2.51 * hdr + 0.03))
            / (hdr * (2.43 * hdr + 0.59) + 0.14),
        0.0,
        1.0
    );
    imageStore(sdrOutput, pixel, vec4(linearToSrgb(mapped), 1.0));
}
