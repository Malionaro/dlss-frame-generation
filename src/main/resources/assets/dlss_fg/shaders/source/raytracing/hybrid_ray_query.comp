#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba8) uniform image2D targetImage;

struct BlockAabb {
    vec4 minimumAndMaximumX;
    vec4 maximumYZColorFlags;
};

struct PointLight {
    vec4 positionAndRadius;
    vec4 colorAndIntensity;
};

layout(std430, set = 0, binding = 2) readonly buffer BlockBuffer {
    BlockAabb blocks[];
};

layout(std140, set = 0, binding = 3) uniform FrameData {
    vec4 cameraPosition;
    vec4 cameraForward; // xyz = forward; w = quality ordinal (informational, do NOT use for ranges — see reflectionParams)
    vec4 cameraRight;
    vec4 cameraUp;
    vec4 renderParameters; // tanHalfFov, aspect, maxDistance, reflection enabled
    vec4 sunDirectionAndSamples;
    vec4 reflectionParams; // x = reflection range in meters (A7: explicit, quality-decoupled)
} frame;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D noisyColorImage;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D diffuseAlbedoImage;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D specularAlbedoImage;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D normalRoughnessImage;
layout(set = 0, binding = 8, r16f) uniform writeonly image2D specularHitDistanceImage;
layout(set = 0, binding = 9) uniform sampler2D rasterDepth;

layout(std430, set = 0, binding = 10) readonly buffer LightBuffer {
    uint lightCount;
    uint pad0;
    uint pad1;
    uint pad2;
    PointLight lights[];
};

struct Hit {
    float distance;
    uint primitive;
    vec3 normal;
    bool valid;
};

float intersectAabb(vec3 origin, vec3 direction, vec3 minimum, vec3 maximum, out vec3 normal) {
    // M5: robust inverseDirection - avoid div-by-zero / Inf for axis-aligned rays
    vec3 safeDir = direction;
    safeDir.x = abs(safeDir.x) < 1e-6 ? (safeDir.x >= 0.0 ? 1e-6 : -1e-6) : safeDir.x;
    safeDir.y = abs(safeDir.y) < 1e-6 ? (safeDir.y >= 0.0 ? 1e-6 : -1e-6) : safeDir.y;
    safeDir.z = abs(safeDir.z) < 1e-6 ? (safeDir.z >= 0.0 ? 1e-6 : -1e-6) : safeDir.z;
    vec3 inverseDirection = 1.0 / safeDir;
    vec3 t0 = (minimum - origin) * inverseDirection;
    vec3 t1 = (maximum - origin) * inverseDirection;
    vec3 nearValues = min(t0, t1);
    vec3 farValues = max(t0, t1);
    float nearDistance = max(max(nearValues.x, nearValues.y), nearValues.z);
    float farDistance = min(min(farValues.x, farValues.y), farValues.z);

    normal = vec3(0.0);
    if (nearDistance > 0.0 && nearDistance <= farDistance) {
        vec3 hit = origin + direction * nearDistance;
        vec3 center = (minimum + maximum) * 0.5;
        vec3 local = hit - center;
        vec3 extent = max((maximum - minimum) * 0.5, vec3(0.0001));
        vec3 axis = abs(local / extent);
        if (axis.x >= axis.y && axis.x >= axis.z) {
            normal.x = sign(local.x);
        } else if (axis.y >= axis.z) {
            normal.y = sign(local.y);
        } else {
            normal.z = sign(local.z);
        }
        return nearDistance;
    }
    return -1.0;
}

Hit traceScene(vec3 origin, vec3 direction, float minimumDistance, float maximumDistance) {
    rayQueryEXT query;
    rayQueryInitializeEXT(
        query,
        scene,
        gl_RayFlagsOpaqueEXT,
        0xff,
        origin,
        minimumDistance,
        direction,
        maximumDistance
    );

    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false)
                == gl_RayQueryCandidateIntersectionAABBEXT) {
            uint primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
            vec3 unusedNormal;
            float distance = intersectAabb(
                origin,
                direction,
                blocks[primitive].minimumAndMaximumX.xyz,
                vec3(
                    blocks[primitive].minimumAndMaximumX.w,
                    blocks[primitive].maximumYZColorFlags.xy
                ),
                unusedNormal
            );
            if (distance >= minimumDistance && distance <= maximumDistance) {
                rayQueryGenerateIntersectionEXT(query, distance);
            }
        }
    }

    Hit hit;
    hit.valid = rayQueryGetIntersectionTypeEXT(query, true)
            != gl_RayQueryCommittedIntersectionNoneEXT;
    if (!hit.valid) {
        hit.distance = maximumDistance;
        hit.primitive = 0u;
        hit.normal = vec3(0.0);
        return hit;
    }

    hit.distance = rayQueryGetIntersectionTEXT(query, true);
    hit.primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
    vec3 ignored;
    intersectAabb(
        origin,
        direction,
        blocks[hit.primitive].minimumAndMaximumX.xyz,
        vec3(
            blocks[hit.primitive].minimumAndMaximumX.w,
            blocks[hit.primitive].maximumYZColorFlags.xy
        ),
        ignored
    );
    vec3 point = origin + direction * hit.distance;
    vec3 minimum = blocks[hit.primitive].minimumAndMaximumX.xyz;
    vec3 maximum = vec3(
        blocks[hit.primitive].minimumAndMaximumX.w,
        blocks[hit.primitive].maximumYZColorFlags.xy
    );
    vec3 center = (minimum + maximum) * 0.5;
    vec3 extent = max((maximum - minimum) * 0.5, vec3(0.0001));
    vec3 axis = abs((point - center) / extent);
    if (axis.x >= axis.y && axis.x >= axis.z) {
        hit.normal = vec3(sign(point.x - center.x), 0.0, 0.0);
    } else if (axis.y >= axis.z) {
        hit.normal = vec3(0.0, sign(point.y - center.y), 0.0);
    } else {
        hit.normal = vec3(0.0, 0.0, sign(point.z - center.z));
    }
    return hit;
}

vec3 unpackColor(float packedAsFloat) {
    uint packed = floatBitsToUint(packedAsFloat);
    return vec3(
        float((packed >> 16u) & 255u),
        float((packed >> 8u) & 255u),
        float(packed & 255u)
    ) / 255.0;
}

vec3 srgbToLinear(vec3 value) {
    vec3 low = value / 12.92;
    vec3 high = pow(
        max((value + 0.055) / 1.055, vec3(0.0)),
        vec3(2.4)
    );
    return mix(high, low, lessThanEqual(value, vec3(0.04045)));
}

vec3 linearToSrgb(vec3 value) {
    vec3 low = value * 12.92;
    vec3 high = 1.055 * pow(
        max(value, vec3(0.0)),
        vec3(1.0 / 2.4)
    ) - 0.055;
    return mix(high, low, lessThanEqual(value, vec3(0.0031308)));
}

vec3 toneMapAces(vec3 hdr) {
    return clamp(
        (hdr * (2.51 * hdr + 0.03))
            / (hdr * (2.43 * hdr + 0.59) + 0.14),
        0.0,
        1.0
    );
}

vec3 rayDirectionForPixel(ivec2 pixel, ivec2 size) {
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;
    return normalize(
        frame.cameraForward.xyz
        + frame.cameraRight.xyz * ndc.x * frame.renderParameters.y
            * frame.renderParameters.x
        + frame.cameraUp.xyz * ndc.y * frame.renderParameters.x
    );
}

float rayDistanceForDepth(float hardwareDepth, vec3 direction) {
    // A9: reversed-Z contract (FrameGuideConventions.REVERSED_ZERO_TO_ONE):
    // hardwareDepth 0.0 = far/sky, 1.0 = near plane. The formula below is the
    // reversed linearization z = n*f/(n+d*(f-n)) — d=0 yields far, d=1 yields
    // near — so it agrees with the convention and with the 0.0 history clear.
    if (hardwareDepth <= 0.0) {
        return frame.cameraUp.w;
    }
    float nearPlane = frame.cameraRight.w;
    float farPlane = frame.cameraUp.w;
    float linearViewDepth = nearPlane * farPlane
        / max(nearPlane + hardwareDepth * (farPlane - nearPlane), 1.0e-5);
    return linearViewDepth
        / max(dot(direction, frame.cameraForward.xyz), 0.05);
}

vec3 reconstructRasterNormal(
    ivec2 pixel,
    ivec2 size,
    float centerDepth,
    vec3 centerDirection
) {
    if (centerDepth <= 0.0) {
        return -centerDirection;
    }
    ivec2 rightPixel = min(pixel + ivec2(1, 0), size - ivec2(1));
    ivec2 downPixel = min(pixel + ivec2(0, 1), size - ivec2(1));
    float rightDepth = texelFetch(rasterDepth, rightPixel, 0).r;
    float downDepth = texelFetch(rasterDepth, downPixel, 0).r;
    if (rightDepth <= 0.0 || downDepth <= 0.0) {
        return -centerDirection;
    }

    vec3 rightDirection = rayDirectionForPixel(rightPixel, size);
    vec3 downDirection = rayDirectionForPixel(downPixel, size);
    vec3 centerPosition = centerDirection
        * rayDistanceForDepth(centerDepth, centerDirection);
    vec3 rightPosition = rightDirection
        * rayDistanceForDepth(rightDepth, rightDirection);
    vec3 downPosition = downDirection
        * rayDistanceForDepth(downDepth, downDirection);
    // M5/M6: NaN-guard - degenerate triangle produces zero cross; fallback to view-facing normal
    vec3 crossVec = cross(downPosition - centerPosition, rightPosition - centerPosition);
    if (dot(crossVec, crossVec) < 1e-12) {
        return -centerDirection;
    }
    vec3 normal = normalize(crossVec);
    if (dot(normal, -centerDirection) < 0.0) {
        normal = -normal;
    }
    return normal;
}

// A9: raster-vs-RT rejection tolerance in meters. A raster hit closer than
// the RT hit minus this tolerance wins (depth precision + AABB vs. raster
// rasterization differences); larger values punch RT-shaped holes, smaller
// values z-fight at grazing angles.
const float RASTER_DEPTH_TOLERANCE_METERS = 0.15;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(targetImage);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec3 direction = rayDirectionForPixel(pixel, size);

    Hit primary = traceScene(
        frame.cameraPosition.xyz,
        direction,
        0.03,
        frame.renderParameters.z
    );
    vec4 raster = imageLoad(targetImage, pixel);
    vec3 linearRaster = srgbToLinear(max(raster.rgb, vec3(0.0)));
    float hardwareDepth = texelFetch(rasterDepth, pixel, 0).r;
    float rasterRayDistance =
        rayDistanceForDepth(hardwareDepth, direction);
    bool rasterGeometryIsCloser = hardwareDepth > 0.0
        && primary.valid
        && rasterRayDistance + RASTER_DEPTH_TOLERANCE_METERS < primary.distance;
    if (rasterGeometryIsCloser) {
        primary.valid = false;
    }
    if (!primary.valid) {
        imageStore(noisyColorImage, pixel, vec4(linearRaster, 1.0));
        imageStore(diffuseAlbedoImage, pixel, vec4(linearRaster, 1.0));
        imageStore(specularAlbedoImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(
            normalRoughnessImage,
            pixel,
            vec4(
                reconstructRasterNormal(
                    pixel,
                    size,
                    hardwareDepth,
                    direction
                ),
                1.0
            )
        );
        // M6: specularHitDistance on miss = maxDistance (not 0) for correct denoiser / reprojection
        imageStore(specularHitDistanceImage, pixel, vec4(frame.renderParameters.z));
        return;
    }

    vec3 point = frame.cameraPosition.xyz + direction * primary.distance;
    vec3 sunDirection = normalize(frame.sunDirectionAndSamples.xyz);
    int sampleCount = clamp(int(frame.sunDirectionAndSamples.w), 1, 8);
    float visibility = 0.0;
    for (int sampleIndex = 0; sampleIndex < sampleCount; sampleIndex++) {
        float angle = 6.2831853 * (
            float(sampleIndex) + fract(sin(dot(vec2(pixel), vec2(12.9898, 78.233))) * 43758.5453)
        ) / float(sampleCount);
        float radius = 0.012 * sqrt((float(sampleIndex) + 0.5) / float(sampleCount));
        vec3 tangent = normalize(abs(sunDirection.y) < 0.95
            ? cross(sunDirection, vec3(0.0, 1.0, 0.0))
            : cross(sunDirection, vec3(1.0, 0.0, 0.0)));
        vec3 bitangent = cross(sunDirection, tangent);
        vec3 sampleDirection = normalize(
            sunDirection
            + tangent * cos(angle) * radius
            + bitangent * sin(angle) * radius
        );
        Hit shadow = traceScene(
            point + primary.normal * 0.03,
            sampleDirection,
            0.03,
            frame.renderParameters.z
        );
        if (shadow.valid) {
            uint shadowFlags = floatBitsToUint(blocks[shadow.primitive].maximumYZColorFlags.w);
            if ((shadowFlags & 4u) != 0u) {
                visibility += 0.65; // Colored glass transparency attenuation
            }
        } else {
            visibility += 1.0;
        }
    }
    visibility /= float(sampleCount);

    // Ray-Traced Ambient Occlusion (RT-AO) for contact shadows in corners
    float rtAo = 1.0;
    vec3 aoDirections[2] = vec3[2](
        normalize(primary.normal + vec3(0.577, 0.577, 0.577)),
        normalize(primary.normal + vec3(-0.577, 0.577, -0.577))
    );
    for (int aoIdx = 0; aoIdx < 2; aoIdx++) {
        Hit aoHit = traceScene(
            point + primary.normal * 0.02,
            aoDirections[aoIdx],
            0.02,
            1.2
        );
        if (aoHit.valid) {
            rtAo -= 0.3 * (1.0 - clamp(aoHit.distance / 1.2, 0.0, 1.0));
        }
    }
    rtAo = clamp(rtAo, 0.25, 1.0);

    float ambient = 0.38 * rtAo;
    float directLight = ambient + (1.0 - ambient) * visibility;
    directLight *= 0.55 + 0.45 * max(dot(primary.normal, sunDirection), 0.0);
    vec3 result = linearRaster * directLight;

    // Material properties and flags
    uint flags = floatBitsToUint(
        blocks[primary.primitive].maximumYZColorFlags.w
    );
    bool isReflective = (flags & 1u) != 0u;
    bool isWater = (flags & 2u) != 0u;
    bool isGlass = (flags & 4u) != 0u;
    bool isEmissive = (flags & 8u) != 0u;
    bool isMetallic = (flags & 16u) != 0u;

    float roughness = 0.82;
    vec3 specularAlbedo = vec3(0.04);
    if (isWater) {
        roughness = 0.04;
        specularAlbedo = vec3(0.02);
    } else if (isMetallic) {
        roughness = 0.15;
        specularAlbedo = linearRaster;
    } else if (isReflective) {
        roughness = 0.22;
        specularAlbedo = vec3(0.55);
    }

    // Dynamic Point Light Illumination (torches, lanterns, lava)
    vec3 pointLightDiffuse = vec3(0.0);
    vec3 pointLightSpecular = vec3(0.0);
    uint numLights = min(lightCount, 32u);
    for (uint i = 0u; i < numLights; i++) {
        vec3 lightPos = lights[i].positionAndRadius.xyz;
        float lightRadius = lights[i].positionAndRadius.w;
        vec3 toLight = lightPos - point;
        float dist = length(toLight);
        if (dist < lightRadius && dist > 0.02) {
            vec3 lightDir = toLight / dist;
            float nDotL = max(dot(primary.normal, lightDir), 0.0);
            if (nDotL > 0.001) {
                Hit lightShadow = traceScene(
                    point + primary.normal * 0.03,
                    lightDir,
                    0.03,
                    dist - 0.04
                );
                float lightVis = 1.0;
                if (lightShadow.valid) {
                    uint shadowFlags = floatBitsToUint(blocks[lightShadow.primitive].maximumYZColorFlags.w);
                    if ((shadowFlags & 4u) != 0u) {
                        lightVis = 0.65;
                    } else {
                        lightVis = 0.0;
                    }
                }
                if (lightVis > 0.0) {
                    float normalizedDist = dist / lightRadius;
                    float atten = clamp(1.0 - normalizedDist * normalizedDist, 0.0, 1.0);
                    atten = (atten * atten) / (1.0 + 0.35 * dist * dist);
                    vec3 lightColor = lights[i].colorAndIntensity.rgb * lights[i].colorAndIntensity.w;
                    pointLightDiffuse += lightColor * (nDotL * atten * lightVis);

                    vec3 halfVector = normalize(lightDir - direction);
                    float nDotH = max(dot(primary.normal, halfVector), 0.0);
                    float specTerm = pow(nDotH, mix(64.0, 8.0, roughness));
                    pointLightSpecular += lightColor * (specTerm * atten * lightVis);
                }
            }
        }
    }
    result += pointLightDiffuse * (linearRaster * 0.95 + vec3(0.05));

    // Emissive block self-illumination (torches, lava, glowstone)
    if (isEmissive) {
        result += linearRaster * 1.5;
    }

    float specularHitDistance = frame.renderParameters.z;
    if (frame.renderParameters.w > 0.5) {
        vec3 reflectionDirection = reflect(direction, primary.normal);
        Hit reflection = traceScene(
            point + primary.normal * 0.04,
            reflectionDirection,
            0.04,
            frame.reflectionParams.x
        );
        vec3 reflectionColor = reflection.valid
            ? srgbToLinear(unpackColor(
                    blocks[reflection.primitive].maximumYZColorFlags.z))
            // A11: reflection miss = escaped ray. Use the pixel's own raster
            // color (which already holds sky/fog) instead of a fixed sky blue
            // that tinted every grazing angle.
            : linearRaster;
        
        float reflectivity = 0.08;
        if (isWater) {
            float nDotV = max(dot(primary.normal, -direction), 0.0);
            float fresnel = 0.02 + 0.98 * pow(1.0 - nDotV, 5.0);
            reflectivity = mix(0.12, 0.88, fresnel);
        } else if (isMetallic) {
            reflectivity = 0.65;
            reflectionColor *= linearRaster;
        } else if (isReflective) {
            reflectivity = 0.38;
        }
        result = mix(result, reflectionColor, reflectivity) + pointLightSpecular * specularAlbedo;
        // M6 (refined A7): on reflection miss report the searched range instead
        // of 0 — the ray found nothing within [0.04, reflectionRange], so the
        // range itself is the truthful lower bound for the hit distance.
        specularHitDistance = reflection.valid ? reflection.distance : frame.reflectionParams.x;
    }

    imageStore(
        targetImage,
        pixel,
        vec4(linearToSrgb(toneMapAces(result)), raster.a)
    );
    imageStore(noisyColorImage, pixel, vec4(result, 1.0));
    imageStore(diffuseAlbedoImage, pixel, vec4(linearRaster, 1.0));
    imageStore(specularAlbedoImage, pixel, vec4(specularAlbedo, 1.0));
    imageStore(
        normalRoughnessImage,
        pixel,
        vec4(normalize(primary.normal), roughness)
    );
    imageStore(
        specularHitDistanceImage,
        pixel,
        vec4(specularHitDistance, 0.0, 0.0, 0.0)
    );
}
