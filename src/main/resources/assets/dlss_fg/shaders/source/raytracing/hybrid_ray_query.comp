#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba8) uniform image2D targetImage;

// Layout: RtBoxFormat.java. faces: per-face sprite ids (16 bit each, order
// -X +X -Y +Y -Z +Z), w = tint rgb | tinted-face mask << 24 | cutout << 30.
struct BlockAabb {
    vec4 minimumAndMaximumX;
    vec4 maximumYZColorFlags;
    uvec4 faces;
};

struct PointLight {
    vec4 positionAndRadius;
    vec4 colorAndIntensity;
};

// One BLAS per 16^3 section; the instance custom index selects the section's
// box list through its device address.
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer BoxList {
    BlockAabb boxes[];
};
layout(std430, set = 0, binding = 2) readonly buffer SectionTable {
    uvec2 sectionBoxes[];
};

layout(std140, set = 0, binding = 3) uniform FrameData {
    vec4 cameraPosition;
    vec4 cameraForward; // xyz = forward; w = quality ordinal (informational, do NOT use for ranges — see reflectionParams)
    vec4 cameraRight;
    vec4 cameraUp;
    vec4 renderParameters; // tanHalfFov, aspect, maxDistance, reflection enabled
    vec4 sunDirectionAndSamples;
    vec4 reflectionParams; // x = reflection range in meters, yz = sub-pixel jitter
    vec4 environment; // rain, thunder, seconds, frame index (uint bits)
    vec4 worldOrigin; // scene origin in world blocks, w = entity count (int bits)
    vec4 skyParams; // x = overworld (has sun and sky), y = sky light at the camera 0-1
    vec4 entities[64]; // per entity: min.xyz, max.xyz relative to the scene origin
} frame;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D noisyColorImage;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D diffuseAlbedoImage;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D specularAlbedoImage;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D normalRoughnessImage;
layout(set = 0, binding = 8, r16f) uniform writeonly image2D specularHitDistanceImage;
layout(set = 0, binding = 9) uniform sampler2D rasterDepth;

layout(std430, set = 0, binding = 11) readonly buffer SpriteTable {
    vec4 sprites[]; // u0 v0 u1 v1 in the block atlas; index 0 = untextured
};
layout(set = 0, binding = 12) uniform sampler2D blockAtlas;

layout(std430, set = 0, binding = 10) readonly buffer LightBuffer {
    uint lightCount;
    uint pad0;
    uint pad1;
    uint pad2;
    PointLight lights[];
};

// Auto exposure. Frame parity p sums log luminance into [p]; the frame
// exposes with the average frame p-1 left in [1-p]. RtRenderer clears [p].
layout(std430, set = 0, binding = 13) buffer ExposureState {
    uint logSum[2];
    uint sampleCount[2];
    float exposure[2];
} exposureState;

struct Hit {
    float distance;
    BlockAabb box;
    vec3 normal;
    bool valid;
};

BlockAabb fetchBox(uint section, uint primitive) {
    return BoxList(sectionBoxes[section]).boxes[primitive];
}

// Boxes are section-local; the instance transform is a pure translation, so
// the offset between world and object ray origin moves them into scene space.
BlockAabb toScene(BlockAabb box, vec3 offset) {
    box.minimumAndMaximumX += vec4(offset, offset.x);
    box.maximumYZColorFlags.xy += offset.yz;
    return box;
}

vec3 boxMinimum(BlockAabb box) {
    return box.minimumAndMaximumX.xyz;
}

vec3 boxMaximum(BlockAabb box) {
    return vec3(box.minimumAndMaximumX.w, box.maximumYZColorFlags.xy);
}

vec3 unpackRgb(uint packed) {
    return vec3(
        float((packed >> 16u) & 255u),
        float((packed >> 8u) & 255u),
        float(packed & 255u)
    ) / 255.0;
}

// sRGB colour and alpha of the box face at point (outward normal): the
// face's atlas sprite, tinted where the model tints it, or the map colour
// for untextured boxes.
vec4 surfaceColor(BlockAabb box, vec3 point, vec3 normal) {
    vec3 cell = point - floor(boxMinimum(box) + vec3(1.0e-4));
    vec3 axis = abs(normal);
    uint face;
    vec2 uv;
    if (axis.x >= axis.y && axis.x >= axis.z) {
        face = normal.x < 0.0 ? 0u : 1u;
        uv = vec2(normal.x < 0.0 ? cell.z : 1.0 - cell.z, 1.0 - cell.y);
    } else if (axis.y >= axis.z) {
        face = normal.y < 0.0 ? 2u : 3u;
        uv = vec2(cell.x, normal.y < 0.0 ? 1.0 - cell.z : cell.z);
    } else {
        face = normal.z < 0.0 ? 4u : 5u;
        uv = vec2(normal.z < 0.0 ? 1.0 - cell.x : cell.x, 1.0 - cell.y);
    }
    uint pair = face < 2u ? box.faces.x : (face < 4u ? box.faces.y : box.faces.z);
    uint sprite = (face & 1u) == 0u ? (pair & 0xFFFFu) : (pair >> 16u);
    if (sprite == 0u) {
        return vec4(unpackRgb(floatBitsToUint(box.maximumYZColorFlags.z)), 1.0);
    }
    vec4 rect = sprites[sprite];
    vec4 texel = textureLod(blockAtlas, mix(rect.xy, rect.zw, clamp(uv, 0.002, 0.998)), 0.0);
    if ((((box.faces.w >> 24u) & 63u) & (1u << face)) != 0u) {
        texel.rgb *= unpackRgb(box.faces.w & 0xFFFFFFu);
    }
    return texel;
}

bool isCutout(BlockAabb box) {
    return (box.faces.w & (1u << 30u)) != 0u;
}

// Entry and exit of the ray through a box, with the outward face normals.
bool slabs(vec3 origin, vec3 direction, vec3 minimum, vec3 maximum,
           out float nearDistance, out float farDistance,
           out vec3 nearNormal, out vec3 farNormal) {
    vec3 safeDir = direction;
    safeDir.x = abs(safeDir.x) < 1e-6 ? (safeDir.x >= 0.0 ? 1e-6 : -1e-6) : safeDir.x;
    safeDir.y = abs(safeDir.y) < 1e-6 ? (safeDir.y >= 0.0 ? 1e-6 : -1e-6) : safeDir.y;
    safeDir.z = abs(safeDir.z) < 1e-6 ? (safeDir.z >= 0.0 ? 1e-6 : -1e-6) : safeDir.z;
    vec3 inverseDirection = 1.0 / safeDir;
    vec3 t0 = (minimum - origin) * inverseDirection;
    vec3 t1 = (maximum - origin) * inverseDirection;
    vec3 nearValues = min(t0, t1);
    vec3 farValues = max(t0, t1);
    nearDistance = max(max(nearValues.x, nearValues.y), nearValues.z);
    farDistance = min(min(farValues.x, farValues.y), farValues.z);
    vec3 stepSign = -sign(safeDir);
    nearNormal = nearDistance == nearValues.x ? vec3(stepSign.x, 0.0, 0.0)
        : (nearDistance == nearValues.y ? vec3(0.0, stepSign.y, 0.0) : vec3(0.0, 0.0, stepSign.z));
    farNormal = farDistance == farValues.x ? vec3(-stepSign.x, 0.0, 0.0)
        : (farDistance == farValues.y ? vec3(0.0, -stepSign.y, 0.0) : vec3(0.0, 0.0, -stepSign.z));
    return farDistance >= max(nearDistance, 0.0);
}


// skipFlags: boxes with any of these flags are passed through (refraction
// through water or glass).
Hit traceScene(vec3 origin, vec3 direction, float minimumDistance, float maximumDistance, uint skipFlags) {
    rayQueryEXT query;
    rayQueryInitializeEXT(
        query,
        scene,
        gl_RayFlagsOpaqueEXT,
        0xff,
        origin,
        minimumDistance,
        direction,
        maximumDistance
    );

    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false)
                == gl_RayQueryCandidateIntersectionAABBEXT) {
            BlockAabb box = toScene(fetchBox(
                rayQueryGetIntersectionInstanceCustomIndexEXT(query, false),
                rayQueryGetIntersectionPrimitiveIndexEXT(query, false)),
                origin - rayQueryGetIntersectionObjectRayOriginEXT(query, false));
            if ((floatBitsToUint(box.maximumYZColorFlags.w) & skipFlags) != 0u) {
                continue;
            }
            float nearDistance;
            float farDistance;
            vec3 nearNormal;
            vec3 farNormal;
            if (!slabs(origin, direction, boxMinimum(box), boxMaximum(box),
                    nearDistance, farDistance, nearNormal, farNormal)) {
                continue;
            }
            bool cutout = isCutout(box);
            if (nearDistance > 0.0 && nearDistance >= minimumDistance
                    && nearDistance <= maximumDistance
                    && (!cutout || surfaceColor(box, origin + direction * nearDistance, nearNormal).a >= 0.5)) {
                rayQueryGenerateIntersectionEXT(query, nearDistance);
            } else if (cutout && farDistance >= minimumDistance
                    && farDistance <= maximumDistance
                    && surfaceColor(box, origin + direction * farDistance, farNormal).a >= 0.5) {
                // Seen through a hole in the near face (leaves): the inside
                // of the far face.
                rayQueryGenerateIntersectionEXT(query, farDistance);
            }
        }
    }

    Hit hit;
    hit.valid = rayQueryGetIntersectionTypeEXT(query, true)
            != gl_RayQueryCommittedIntersectionNoneEXT;
    if (!hit.valid) {
        hit.distance = maximumDistance;
        hit.normal = vec3(0.0);
        return hit;
    }

    hit.distance = rayQueryGetIntersectionTEXT(query, true);
    hit.box = toScene(fetchBox(
        rayQueryGetIntersectionInstanceCustomIndexEXT(query, true),
        rayQueryGetIntersectionPrimitiveIndexEXT(query, true)),
        origin - rayQueryGetIntersectionObjectRayOriginEXT(query, true));
    vec3 point = origin + direction * hit.distance;
    vec3 minimum = boxMinimum(hit.box);
    vec3 maximum = boxMaximum(hit.box);
    vec3 center = (minimum + maximum) * 0.5;
    vec3 extent = max((maximum - minimum) * 0.5, vec3(0.0001));
    vec3 axis = abs((point - center) / extent);
    if (axis.x >= axis.y && axis.x >= axis.z) {
        hit.normal = vec3(sign(point.x - center.x), 0.0, 0.0);
    } else if (axis.y >= axis.z) {
        hit.normal = vec3(0.0, sign(point.y - center.y), 0.0);
    } else {
        hit.normal = vec3(0.0, 0.0, sign(point.z - center.z));
    }
    return hit;
}

vec3 unpackColor(float packedAsFloat) {
    uint packed = floatBitsToUint(packedAsFloat);
    return vec3(
        float((packed >> 16u) & 255u),
        float((packed >> 8u) & 255u),
        float(packed & 255u)
    ) / 255.0;
}

vec3 srgbToLinear(vec3 value) {
    vec3 low = value / 12.92;
    vec3 high = pow(
        max((value + 0.055) / 1.055, vec3(0.0)),
        vec3(2.4)
    );
    return mix(high, low, lessThanEqual(value, vec3(0.04045)));
}

vec3 linearToSrgb(vec3 value) {
    vec3 low = value * 12.92;
    vec3 high = 1.055 * pow(
        max(value, vec3(0.0)),
        vec3(1.0 / 2.4)
    ) - 0.055;
    return mix(high, low, lessThanEqual(value, vec3(0.0031308)));
}

vec3 toneMapAces(vec3 hdr) {
    return clamp(
        (hdr * (2.51 * hdr + 0.03))
            / (hdr * (2.43 * hdr + 0.59) + 0.14),
        0.0,
        1.0
    );
}

vec3 rayDirectionForPixel(ivec2 pixel, ivec2 size) {
    // Same jittered sample point as the raster image under it, so DLSS sees
    // RT lighting and geometry move together.
    vec2 uv = (vec2(pixel) + vec2(0.5) - frame.reflectionParams.yz) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;
    return normalize(
        frame.cameraForward.xyz
        + frame.cameraRight.xyz * ndc.x * frame.renderParameters.y
            * frame.renderParameters.x
        + frame.cameraUp.xyz * ndc.y * frame.renderParameters.x
    );
}

float rayDistanceForDepth(float hardwareDepth, vec3 direction) {
    // Reversed-Z contract (FrameGuideConventions.REVERSED_ZERO_TO_ONE):
    // hardwareDepth 0.0 = far/sky, 1.0 = near plane. The formula below is the
    // reversed linearization z = n*f/(n+d*(f-n)) — d=0 yields far, d=1 yields
    // near — so it agrees with the convention and with the 0.0 history clear.
    if (hardwareDepth <= 0.0) {
        return frame.cameraUp.w;
    }
    float nearPlane = frame.cameraRight.w;
    float farPlane = frame.cameraUp.w;
    float linearViewDepth = nearPlane * farPlane
        / max(nearPlane + hardwareDepth * (farPlane - nearPlane), 1.0e-5);
    return linearViewDepth
        / max(dot(direction, frame.cameraForward.xyz), 0.05);
}

vec3 reconstructRasterNormal(
    ivec2 pixel,
    ivec2 size,
    float centerDepth,
    vec3 centerDirection
) {
    if (centerDepth <= 0.0) {
        return -centerDirection;
    }
    ivec2 rightPixel = min(pixel + ivec2(1, 0), size - ivec2(1));
    ivec2 downPixel = min(pixel + ivec2(0, 1), size - ivec2(1));
    float rightDepth = texelFetch(rasterDepth, rightPixel, 0).r;
    float downDepth = texelFetch(rasterDepth, downPixel, 0).r;
    if (rightDepth <= 0.0 || downDepth <= 0.0) {
        return -centerDirection;
    }

    vec3 rightDirection = rayDirectionForPixel(rightPixel, size);
    vec3 downDirection = rayDirectionForPixel(downPixel, size);
    vec3 centerPosition = centerDirection
        * rayDistanceForDepth(centerDepth, centerDirection);
    vec3 rightPosition = rightDirection
        * rayDistanceForDepth(rightDepth, rightDirection);
    vec3 downPosition = downDirection
        * rayDistanceForDepth(downDepth, downDirection);
    // NaN guard: a degenerate triangle has a zero cross product; fall back to view-facing normal
    vec3 crossVec = cross(downPosition - centerPosition, rightPosition - centerPosition);
    if (dot(crossVec, crossVec) < 1e-12) {
        return -centerDirection;
    }
    vec3 normal = normalize(crossVec);
    if (dot(normal, -centerDirection) < 0.0) {
        normal = -normal;
    }
    return normal;
}

// Raster-vs-RT rejection tolerance in meters. A raster hit closer than
// the RT hit minus this tolerance wins (depth precision + AABB vs. raster
// rasterization differences); larger values punch RT-shaped holes, smaller
// values z-fight at grazing angles.
const float RASTER_DEPTH_TOLERANCE_METERS = 0.15;

// ---------------------------------------------------------------------------
// Lighting. Everything inside the RT range is lit here from the block
// textures (albedo) instead of reusing vanilla's baked lighting: sun or moon
// with soft shadows, sky light with one bounce, block lights, emission,
// specular from water, metals, glass and rain-wet ground, and atmospheric
// fog. Outside the range the raster image stays, blended at the edge.
// ---------------------------------------------------------------------------

const uint FLAG_REFLECTIVE = 1u;
const uint FLAG_WATER = 2u;
const uint FLAG_GLASS = 4u;
const uint FLAG_EMISSIVE = 8u;
const uint FLAG_METALLIC = 16u;
const float CLOUD_HEIGHT = 192.33;
const float PI = 3.14159265;

uint boxFlags(BlockAabb box) {
    return floatBitsToUint(box.maximumYZColorFlags.w);
}

// Vanilla sky light next to the block, 0-1. Without it every cave whose
// ceiling lies outside the RT scene would be lit by the open sky.
float skyAccess(BlockAabb box) {
    return float((boxFlags(box) >> 8u) & 15u) / 15.0;
}

float sunAccess(BlockAabb box) {
    return smoothstep(0.55, 0.95, skyAccess(box));
}

bool overworld() {
    return frame.skyParams.x > 0.5;
}

float rainLevel() {
    return frame.environment.x;
}

uint rngState;

float random01() {
    rngState = rngState * 747796405u + 2891336453u;
    uint word = ((rngState >> ((rngState >> 28u) + 4u)) ^ rngState) * 277803737u;
    return float((word >> 22u) ^ word) / 4294967296.0;
}

vec3 cosineHemisphere(vec3 normal) {
    float u = random01();
    float v = random01();
    float radius = sqrt(u);
    float angle = 2.0 * PI * v;
    vec3 tangent = normalize(abs(normal.y) < 0.95
        ? cross(normal, vec3(0.0, 1.0, 0.0))
        : cross(normal, vec3(1.0, 0.0, 0.0)));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * (radius * cos(angle))
        + bitangent * (radius * sin(angle))
        + normal * sqrt(max(0.0, 1.0 - u)));
}

float hash2(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float valueNoise(vec2 p) {
    vec2 cell = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(hash2(cell), hash2(cell + vec2(1.0, 0.0)), f.x),
        mix(hash2(cell + vec2(0.0, 1.0)), hash2(cell + vec2(1.0, 1.0)), f.x),
        f.y);
}

float fbm(vec2 p) {
    float sum = 0.0;
    float amplitude = 0.5;
    for (int octave = 0; octave < 4; octave++) {
        sum += amplitude * valueNoise(p);
        p = p * 2.03 + vec2(17.1, 9.7);
        amplitude *= 0.5;
    }
    return sum;
}

// Direction towards the light that currently lights the world: the sun by
// day, the moon (opposite side) by night.
vec3 mainLightDirection() {
    vec3 sun = normalize(frame.sunDirectionAndSamples.xyz);
    return sun.y > -0.05 ? sun : -sun;
}

vec3 mainLightColor() {
    if (!overworld()) {
        return vec3(0.0);
    }
    vec3 sun = normalize(frame.sunDirectionAndSamples.xyz);
    float weather = 1.0 - 0.75 * rainLevel() - 0.15 * frame.environment.y;
    if (sun.y > -0.05) {
        float height = clamp(sun.y, 0.0, 1.0);
        vec3 tint = mix(vec3(1.0, 0.45, 0.2), vec3(1.0, 0.96, 0.9), smoothstep(0.0, 0.35, height));
        return tint * 2.6 * smoothstep(-0.05, 0.12, sun.y) * weather;
    }
    return vec3(0.35, 0.42, 0.6) * 0.18 * smoothstep(0.05, 0.25, -sun.y) * weather;
}

// Analytic sky: Rayleigh-like gradient, Mie glow around the sun, sunset
// tint, rain grey, dark night sky. Linear radiance.
vec3 skyRadiance(vec3 direction) {
    if (!overworld()) {
        return vec3(0.05, 0.03, 0.03);
    }
    vec3 sun = normalize(frame.sunDirectionAndSamples.xyz);
    float day = smoothstep(-0.15, 0.2, sun.y);
    float up = clamp(direction.y, 0.0, 1.0);
    vec3 zenith = vec3(0.18, 0.38, 0.85);
    vec3 horizon = vec3(0.65, 0.78, 0.95);
    vec3 sky = mix(horizon, zenith, pow(up, 0.55));
    float sunset = (1.0 - smoothstep(0.0, 0.35, abs(sun.y))) * day;
    float towardsSun = max(dot(direction, sun), 0.0);
    sky = mix(sky, vec3(1.0, 0.5, 0.25), sunset * pow(1.0 - up, 3.0) * (0.3 + 0.7 * towardsSun));
    sky += vec3(1.0, 0.85, 0.6) * pow(towardsSun, 8.0) * 0.6 * day;
    sky *= mix(0.012, 1.2, day);
    vec3 grey = vec3(0.42, 0.45, 0.5) * mix(0.01, 0.7, day);
    sky = mix(sky, grey, clamp(rainLevel(), 0.0, 1.0) * 0.85);
    if (direction.y < 0.0) {
        // Below the horizon: darker ground bounce instead of a mirrored sky.
        sky *= mix(1.0, 0.35, clamp(-direction.y * 3.0, 0.0, 1.0));
    }
    return sky;
}

// Cloud layer at vanilla cloud height, drifting with time.
vec4 cloudLayer(vec3 origin, vec3 direction) {
    if (!overworld() || abs(direction.y) < 1.0e-3) {
        return vec4(0.0);
    }
    float planeY = CLOUD_HEIGHT - frame.worldOrigin.y;
    float t = (planeY - origin.y) / direction.y;
    if (t <= 0.0 || t > 4000.0) {
        return vec4(0.0);
    }
    vec2 world = (origin.xz + direction.xz * t + frame.worldOrigin.xz) / 96.0
        + vec2(frame.environment.z * 0.012, 0.0);
    float density = fbm(world);
    float cover = mix(0.55, 0.3, rainLevel());
    float alpha = smoothstep(cover, cover + 0.2, density) * (1.0 - smoothstep(1500.0, 4000.0, t));
    vec3 sun = normalize(frame.sunDirectionAndSamples.xyz);
    float day = smoothstep(-0.15, 0.2, sun.y);
    vec3 lit = mix(vec3(0.02), vec3(1.25, 1.22, 1.18), day) * mix(1.0, 0.5, rainLevel());
    vec3 shade = lit * mix(0.65, 1.0, fbm(world * 2.0 + 3.0));
    return vec4(shade, alpha);
}

vec3 skyWithClouds(vec3 origin, vec3 direction) {
    vec3 sky = skyRadiance(direction);
    vec4 clouds = cloudLayer(origin, direction);
    return mix(sky, clouds.rgb, clouds.a);
}

// Ray against the entity boxes (shadow casters only).
bool hitsEntity(vec3 origin, vec3 direction, float maximumDistance) {
    int count = min(floatBitsToInt(frame.worldOrigin.w), 32);
    for (int index = 0; index < count; index++) {
        vec3 minimum = frame.entities[index * 2].xyz;
        vec3 maximum = frame.entities[index * 2 + 1].xyz;
        float nearDistance;
        float farDistance;
        vec3 nearNormal;
        vec3 farNormal;
        if (slabs(origin, direction, minimum, maximum,
                nearDistance, farDistance, nearNormal, farNormal)
                && nearDistance > 0.05 && nearDistance < maximumDistance) {
            return true;
        }
    }
    return false;
}

// Light that reaches the point from the main light along lightDirection;
// water and glass let part of it through.
float lightVisibility(vec3 point, vec3 normal, vec3 lightDirection, bool entities) {
    vec3 origin = point + normal * 0.03;
    Hit blocker = traceScene(origin, lightDirection, 0.03, frame.renderParameters.z, 0u);
    float visibility = 1.0;
    if (blocker.valid) {
        uint flags = boxFlags(blocker.box);
        visibility = (flags & FLAG_GLASS) != 0u ? 0.7 : ((flags & FLAG_WATER) != 0u ? 0.55 : 0.0);
    }
    if (visibility > 0.0 && entities && hitsEntity(origin, lightDirection, frame.renderParameters.z)) {
        visibility = 0.0;
    }
    return visibility;
}

vec3 jitterTowards(vec3 direction, float radius) {
    float angle = 2.0 * PI * random01();
    float r = radius * sqrt(random01());
    vec3 tangent = normalize(abs(direction.y) < 0.95
        ? cross(direction, vec3(0.0, 1.0, 0.0))
        : cross(direction, vec3(1.0, 0.0, 0.0)));
    vec3 bitangent = cross(direction, tangent);
    return normalize(direction + tangent * (cos(angle) * r) + bitangent * (sin(angle) * r));
}

vec3 albedoOf(BlockAabb box, vec3 point, vec3 normal) {
    return srgbToLinear(surfaceColor(box, point, normal).rgb);
}

// Block lights (torches, lanterns, lava) with shadow rays.
vec3 blockLighting(vec3 point, vec3 normal, int maximumLights) {
    vec3 sum = vec3(0.0);
    uint count = min(lightCount, uint(maximumLights));
    for (uint index = 0u; index < count; index++) {
        vec3 toLight = lights[index].positionAndRadius.xyz - point;
        float radius = lights[index].positionAndRadius.w;
        float distanceToLight = length(toLight);
        if (distanceToLight >= radius || distanceToLight < 0.02) {
            continue;
        }
        vec3 direction = toLight / distanceToLight;
        float nDotL = max(dot(normal, direction), 0.0);
        if (nDotL < 0.001) {
            continue;
        }
        Hit blocker = traceScene(point + normal * 0.03, direction, 0.03, distanceToLight - 0.04, 0u);
        float visibility = blocker.valid
            ? ((boxFlags(blocker.box) & FLAG_GLASS) != 0u ? 0.65 : 0.0) : 1.0;
        if (visibility <= 0.0) {
            continue;
        }
        float falloff = clamp(1.0 - pow(distanceToLight / radius, 2.0), 0.0, 1.0);
        falloff = falloff * falloff / (1.0 + 0.35 * distanceToLight * distanceToLight);
        sum += lights[index].colorAndIntensity.rgb * lights[index].colorAndIntensity.w
            * (nDotL * falloff * visibility);
    }
    return sum;
}

// Cheap shading for secondary hits (bounce light, reflections, refraction):
// direct light with one shadow ray, sky ambient, block lights and emission.
vec3 shadeSecondary(Hit hit, vec3 origin, vec3 direction, int maximumLights) {
    vec3 point = origin + direction * hit.distance;
    vec3 albedo = albedoOf(hit.box, point, hit.normal);
    vec3 lightDirection = mainLightDirection();
    float nDotL = max(dot(hit.normal, lightDirection), 0.0);
    float sky = skyAccess(hit.box);
    vec3 light = vec3(0.0);
    if (nDotL > 0.0 && sunAccess(hit.box) > 0.0) {
        light += mainLightColor() * nDotL * sunAccess(hit.box)
            * lightVisibility(point, hit.normal, lightDirection, false);
    }
    float skyFacing = 0.35 + 0.65 * clamp(hit.normal.y * 0.5 + 0.5, 0.0, 1.0);
    light += skyRadiance(vec3(0.0, 1.0, 0.0)) * 0.35 * skyFacing * sky * sky;
    if (maximumLights > 0) {
        light += blockLighting(point, hit.normal, maximumLights);
    }
    vec3 color = albedo * light;
    if ((boxFlags(hit.box) & FLAG_EMISSIVE) != 0u) {
        color += albedo * 2.0;
    }
    return color;
}

// Sky light and one bounce, cosine-sampled. Denoised by Ray Reconstruction,
// accumulated by DLSS otherwise.
vec3 indirectLighting(vec3 point, vec3 normal, int sampleCount, float sky) {
    vec3 sum = vec3(0.0);
    // A ray that leaves the RT scene only reaches the sky if the surface
    // actually sees it.
    float openSky = sky * sky;
    for (int sampleIndex = 0; sampleIndex < sampleCount; sampleIndex++) {
        vec3 direction = cosineHemisphere(normal);
        Hit bounce = traceScene(point + normal * 0.03, direction, 0.03, 32.0, 0u);
        if (!bounce.valid) {
            sum += skyRadiance(direction) * openSky;
        } else if ((boxFlags(bounce.box) & (FLAG_WATER | FLAG_GLASS)) != 0u) {
            sum += skyRadiance(direction) * 0.6 * openSky;
        } else {
            // Bounces skip block lights: too many rays for a faint term.
            sum += shadeSecondary(bounce, point + normal * 0.03, direction, 0);
        }
    }
    return sum / float(sampleCount);
}

vec3 applyFog(vec3 color, vec3 direction, float distanceToPoint, float sky) {
    float density = mix(0.0022, 0.012, rainLevel());
    if (!overworld()) {
        density = 0.006;
    }
    float fog = 1.0 - exp(-distanceToPoint * density);
    // Underground the fog is dark, not sky coloured.
    vec3 fogColor = skyRadiance(normalize(vec3(direction.x, max(direction.y, 0.02), direction.z)))
        * mix(0.04, 1.0, sky);
    return mix(color, fogColor, clamp(fog, 0.0, 0.85));
}

// Exposure from last frame's average luminance of the RT-lit pixels,
// adapting smoothly: brighter in caves and at night, darker in bright sun.
float adaptedExposure(uint parity) {
    uint previousIndex = 1u - parity;
    float previous = exposureState.exposure[previousIndex];
    if (!(previous > 0.0) || previous > 16.0) {
        previous = 1.0;
    }
    uint count = exposureState.sampleCount[previousIndex];
    if (count < 64u) {
        return previous;
    }
    float averageLog = float(exposureState.logSum[previousIndex]) / float(count) / 256.0 - 16.0;
    float target = clamp(0.3 / exp2(averageLog), 0.6, 3.0);
    return mix(previous, target, 0.04);
}

void recordLuminance(ivec2 pixel, uint parity, vec3 color) {
    // Every 8th pixel in each direction: enough for an average, and the
    // fixed-point sum cannot overflow.
    if ((pixel.x & 7) != 0 || (pixel.y & 7) != 0) {
        return;
    }
    float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
    float encoded = clamp(log2(luminance + 1.0e-4) + 16.0, 0.0, 32.0) * 256.0;
    atomicAdd(exposureState.logSum[parity], uint(encoded));
    atomicAdd(exposureState.sampleCount[parity], 1u);
}

// Sun or moon light scattered towards the camera by haze along the view ray,
// shadowed by the scene: light shafts through trees, windows and caves.
vec3 lightShafts(vec3 origin, vec3 direction, float distanceToPoint) {
    int steps = int(frame.cameraForward.w + 0.5) * 3 - 1; // LOW 0 .. ULTRA 8
    if (steps <= 0 || !overworld()) {
        return vec3(0.0);
    }
    float gate = smoothstep(0.5, 0.95, frame.skyParams.y);
    vec3 lightColor = mainLightColor();
    if (gate <= 0.0 || lightColor.r <= 0.0) {
        return vec3(0.0);
    }
    vec3 lightDirection = mainLightDirection();
    float marchLength = min(distanceToPoint, 64.0);
    float stepLength = marchLength / float(steps);
    float offset = random01();
    float density = mix(0.006, 0.03, rainLevel());
    float cosine = dot(direction, lightDirection);
    const float g = 0.55;
    float phase = (1.0 - g * g) / (4.0 * PI * pow(1.0 + g * g - 2.0 * g * cosine, 1.5));
    float lit = 0.0;
    for (int stepIndex = 0; stepIndex < steps; stepIndex++) {
        float t = (float(stepIndex) + offset) * stepLength;
        Hit blocker = traceScene(origin + direction * t, lightDirection, 0.05,
            frame.renderParameters.z, FLAG_GLASS);
        if (!blocker.valid) {
            lit += exp(-density * t);
        }
    }
    return lightColor * (phase * density * stepLength * lit * gate * 4.0);
}

float fresnelSchlick(float f0, float cosine) {
    return f0 + (1.0 - f0) * pow(1.0 - clamp(cosine, 0.0, 1.0), 5.0);
}

// Animated water surface normal (small waves), anchored in world space.
vec3 waterNormal(vec3 point) {
    vec2 world = point.xz + frame.worldOrigin.xz;
    vec2 drift = vec2(frame.environment.z * 0.35, frame.environment.z * 0.21);
    float eps = 0.08;
    float h = fbm(world * 0.9 + drift);
    float hx = fbm((world + vec2(eps, 0.0)) * 0.9 + drift);
    float hz = fbm((world + vec2(0.0, eps)) * 0.9 + drift);
    float strength = mix(0.06, 0.12, rainLevel());
    return normalize(vec3((h - hx) / eps * strength, 1.0, (h - hz) / eps * strength));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(targetImage);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    rngState = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u
        + floatBitsToUint(frame.environment.w) * 26699u;
    random01();

    vec3 direction = rayDirectionForPixel(pixel, size);
    vec3 camera = frame.cameraPosition.xyz;
    float maxDistance = frame.renderParameters.z;
    int sampleCount = clamp(int(frame.sunDirectionAndSamples.w), 1, 8);
    int shadowSamples = min(sampleCount, 4);
    int bounceSamples = clamp((sampleCount + 1) / 2, 1, 4);
    uint parity = floatBitsToUint(frame.environment.w) & 1u;
    float exposure = adaptedExposure(parity);
    if (pixel == ivec2(0)) {
        exposureState.exposure[parity] = exposure;
    }
    vec3 lightDirection = mainLightDirection();
    vec3 lightColor = mainLightColor();

    Hit primary = traceScene(camera, direction, 0.03, maxDistance, 0u);
    vec4 raster = imageLoad(targetImage, pixel);
    vec3 linearRaster = srgbToLinear(max(raster.rgb, vec3(0.0)));
    float hardwareDepth = texelFetch(rasterDepth, pixel, 0).r;
    float rasterRayDistance = rayDistanceForDepth(hardwareDepth, direction);
    if (hardwareDepth > 0.0 && primary.valid
            && rasterRayDistance + RASTER_DEPTH_TOLERANCE_METERS < primary.distance) {
        primary.valid = false;
    }

    if (!primary.valid) {
        // Raster only: entities, the hand, particles, sky and everything
        // beyond the RT range. Entities still receive RT shadows.
        vec3 normal = reconstructRasterNormal(pixel, size, hardwareDepth, direction);
        vec3 result = linearRaster;
        bool changed = false;
        if (hardwareDepth > 0.0 && rasterRayDistance < maxDistance * 0.9 && overworld()) {
            changed = true;
            vec3 point = camera + direction * rasterRayDistance;
            float visibility = lightVisibility(point, normal,
                jitterTowards(lightDirection, 0.012), false);
            float shadowStrength = 0.45 * smoothstep(0.0, 0.3, lightColor.r)
                * (1.0 - smoothstep(maxDistance * 0.6, maxDistance * 0.9, rasterRayDistance));
            result *= 1.0 - shadowStrength * (1.0 - visibility);
        }
        // Light shafts in front of entities and the sky as well.
        vec3 shafts = lightShafts(camera, direction,
            hardwareDepth > 0.0 ? rasterRayDistance : 64.0);
        if (dot(shafts, shafts) > 0.0) {
            result += toneMapAces(shafts * exposure);
            changed = true;
        }
        if (changed) {
            imageStore(targetImage, pixel, vec4(linearToSrgb(result), raster.a));
        }
        imageStore(noisyColorImage, pixel, vec4(result, 1.0));
        imageStore(diffuseAlbedoImage, pixel, vec4(result, 1.0));
        imageStore(specularAlbedoImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(normalRoughnessImage, pixel, vec4(normal, 1.0));
        imageStore(specularHitDistanceImage, pixel, vec4(maxDistance));
        return;
    }

    vec3 point = camera + direction * primary.distance;
    vec3 normal = primary.normal;
    uint flags = boxFlags(primary.box);
    bool isWater = (flags & FLAG_WATER) != 0u;
    bool isGlass = (flags & FLAG_GLASS) != 0u;
    bool isMetallic = (flags & FLAG_METALLIC) != 0u;
    bool isReflective = (flags & FLAG_REFLECTIVE) != 0u;
    vec3 albedo = albedoOf(primary.box, point, normal);
    float sky = skyAccess(primary.box);
    float sun = sunAccess(primary.box);

    float roughness = 0.85;
    float f0 = 0.04;
    vec3 specularAlbedo = vec3(0.04);

    // Rain: sky-exposed upward faces get wet, darker and glossy, with puddles.
    // Sky light 14+ next to an upward face means open sky above, as for rain.
    if (rainLevel() > 0.01 && normal.y > 0.5 && !isWater && overworld() && sky > 0.9) {
        {
            vec2 world = point.xz + frame.worldOrigin.xz;
            float puddle = smoothstep(0.45, 0.65, fbm(world * 0.35));
            float wet = rainLevel() * mix(0.55, 1.0, puddle);
            albedo *= mix(1.0, 0.55, wet);
            roughness = mix(roughness, 0.08, wet);
            f0 = mix(f0, 0.02 + 0.1 * puddle, wet);
            specularAlbedo = vec3(f0);
        }
    }
    if (isMetallic) {
        roughness = 0.2;
        f0 = 0.7;
        specularAlbedo = albedo;
    } else if (isReflective && !isWater) {
        roughness = 0.25;
        f0 = 0.35;
        specularAlbedo = vec3(0.35);
    }
    if (isWater) {
        normal = waterNormal(point);
        roughness = 0.03;
        f0 = 0.02;
        specularAlbedo = vec3(0.02);
    }
    if (isGlass) {
        roughness = 0.05;
        f0 = 0.04;
    }

    // Diffuse: main light with soft shadows, sky light + one bounce, block
    // lights and emission.
    vec3 diffuseLight = vec3(0.0);
    float nDotL = max(dot(normal, lightDirection), 0.0);
    if (nDotL > 0.0 && lightColor.r > 0.0 && sun > 0.0) {
        float visibility = 0.0;
        for (int sampleIndex = 0; sampleIndex < shadowSamples; sampleIndex++) {
            visibility += lightVisibility(point, primary.normal,
                jitterTowards(lightDirection, 0.012), true);
        }
        diffuseLight += lightColor * nDotL * sun * (visibility / float(shadowSamples));
    }
    diffuseLight += indirectLighting(point, primary.normal, bounceSamples, sky);
    diffuseLight += blockLighting(point, primary.normal, 8);
    // Never pitch black, like vanilla's minimum brightness.
    diffuseLight += vec3(0.012);
    vec3 result = albedo * diffuseLight;
    if ((flags & FLAG_EMISSIVE) != 0u) {
        result += albedo * 2.0;
    }

    float cosine = max(dot(normal, -direction), 0.0);
    float fresnel = fresnelSchlick(f0, cosine);

    // Water and glass: what is behind, refracted and absorbed.
    if (isWater || isGlass) {
        vec3 refracted = refract(direction, normal, isWater ? 1.0 / 1.33 : 1.0 / 1.5);
        if (dot(refracted, refracted) < 1.0e-4) {
            refracted = direction;
        }
        uint skip = isWater ? FLAG_WATER : FLAG_GLASS;
        vec3 inside = point - primary.normal * 0.02;
        Hit behind = traceScene(inside, refracted, 0.02, 48.0, skip);
        vec3 behindColor = behind.valid
            ? shadeSecondary(behind, inside, refracted, 2)
            : skyWithClouds(point, refracted) * sky;
        if (isWater) {
            float depth = behind.valid ? behind.distance : 48.0;
            vec3 absorption = exp(-vec3(0.45, 0.12, 0.08) * depth);
            vec3 scatter = vec3(0.02, 0.09, 0.12) * (lightColor.r * 0.4 + 0.08);
            result = behindColor * absorption + scatter * (1.0 - absorption);
        } else {
            result = mix(behindColor, result, 0.25) * mix(vec3(1.0), albedo, 0.5);
        }
    }

    // Specular reflection: always for water, glass and wet ground, for other
    // surfaces with the reflection setting.
    float specularHitDistance = maxDistance;
    bool wantReflection = frame.renderParameters.w > 0.5 || isWater || isGlass || roughness < 0.3;
    if (wantReflection && (fresnel > 0.03 || isMetallic || isReflective)) {
        vec3 reflectionDirection = reflect(direction, normal);
        if (roughness > 0.1) {
            reflectionDirection = normalize(mix(reflectionDirection,
                cosineHemisphere(normal), roughness * roughness * 0.5));
        }
        if (dot(reflectionDirection, primary.normal) < 0.0) {
            reflectionDirection = reflect(reflectionDirection, primary.normal);
        }
        vec3 reflectionOrigin = point + primary.normal * 0.04;
        Hit reflection = traceScene(reflectionOrigin, reflectionDirection,
            0.04, frame.reflectionParams.x, 0u);
        vec3 reflectionColor = reflection.valid
            ? shadeSecondary(reflection, reflectionOrigin, reflectionDirection, 2)
            : skyWithClouds(point, reflectionDirection) * mix(0.05, 1.0, sky);
        // Highlight of the sun or moon.
        vec3 halfVector = normalize(lightDirection - direction);
        float highlight = pow(max(dot(normal, halfVector), 0.0), mix(400.0, 16.0, roughness));
        if (highlight > 1.0e-3 && sun > 0.0) {
            reflectionColor += lightColor * highlight * 4.0 * sun
                * lightVisibility(point, primary.normal, lightDirection, false);
        }
        // Water and ice also carry the reflective flag; they follow Fresnel.
        float weight = isMetallic ? 0.7
            : (isWater || isGlass ? fresnel : (isReflective ? 0.35 : fresnel));
        vec3 tint = isMetallic ? albedo : vec3(1.0);
        result = mix(result, reflectionColor * tint, clamp(weight, 0.0, 1.0));
        specularHitDistance = reflection.valid ? reflection.distance : frame.reflectionParams.x;
    }

    result = applyFog(result, direction, primary.distance, sky);
    result += lightShafts(camera, direction, primary.distance);
    recordLuminance(pixel, parity, result);
    result *= exposure;

    // Fade into the raster image at the edge of the RT range.
    float edge = smoothstep(maxDistance * 0.75, maxDistance, primary.distance);
    vec3 displayed = mix(toneMapAces(result), linearRaster, edge);

    imageStore(targetImage, pixel, vec4(linearToSrgb(displayed), raster.a));
    imageStore(noisyColorImage, pixel, vec4(mix(result, linearRaster, edge), 1.0));
    imageStore(diffuseAlbedoImage, pixel, vec4(mix(albedo, linearRaster, edge), 1.0));
    imageStore(specularAlbedoImage, pixel, vec4(specularAlbedo, 1.0));
    imageStore(normalRoughnessImage, pixel, vec4(normalize(normal), roughness));
    imageStore(specularHitDistanceImage, pixel, vec4(specularHitDistance, 0.0, 0.0, 0.0));
}
