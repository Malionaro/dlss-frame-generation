{
  "schemaVersion": 1,
  "id": "dlss_fg",
  "version": "${version}",
  "name": "Vulkan Frame Generation Integration",
  "description": "Experimental, capability-gated Vulkan integration for NVIDIA Streamline, AMD FidelityFX, Intel/FSR compatibility, OptiScaler and hybrid hardware ray queries.",
  "authors": [
    "Malionaro"
  ],
  "contact": {
    "homepage": "https://github.com/Malionaro/dlss-frame-generation",
    "sources": "https://github.com/Malionaro/dlss-frame-generation",
    "issues": "https://github.com/Malionaro/dlss-frame-generation/issues"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.malionaro.dlss_frame_generation.client.FrameGenMod"
    ],
    "modmenu": [
      "org.malionaro.dlss_frame_generation.client.compat.ModMenuIntegration"
    ],
    "sodium:config_api_user": [
      "org.malionaro.dlss_frame_generation.client.compat.SodiumOptionsEntrypoint"
    ]
  },
  "mixins": [
    {
      "config": "dlss_fg.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "sodium": ">=0.9.1",
    "iris": ">=1.11.2",
    "modmenu": ">=21.0.0"
  }
}
